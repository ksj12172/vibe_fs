generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id           Int      @id @default(autoincrement())
  corpCode     String   @unique @map("corp_code") @db.VarChar(8)
  corpName     String   @map("corp_name") @db.VarChar(255)
  corpEngName  String?  @map("corp_eng_name") @db.VarChar(255)
  stockCode    String?  @map("stock_code") @db.VarChar(6)
  createdAt    DateTime @default(now()) @map("created_at")
  description  String?  @map("description")
  founded      String?  @map("founded") @db.VarChar(20)
  headquarters String?  @map("headquarters") @db.VarChar(255)
  industry     String?  @map("industry") @db.VarChar(100)
  logo         String?  @map("logo") @db.VarChar(500)
  sector       String?  @map("sector") @db.VarChar(100)
  website      String?  @map("website") @db.VarChar(255)

  @@index([corpName], map: "idx_corp_name")
  @@index([corpCode], map: "idx_corp_code")
  @@index([stockCode], map: "idx_stock_code")
  @@map("companies")
}

model Stock {
  id          Int      @id @default(autoincrement())
  symbol      String   @unique @db.VarChar(20)
  name        String   @map("name") @db.VarChar(255)
  nameKor     String?  @map("name_kor") @db.VarChar(255)
  nameEng     String?  @map("name_eng") @db.VarChar(255)
  market      String   @map("market") @db.VarChar(10)
  exchange    String?  @map("exchange") @db.VarChar(20)
  sector      String?  @map("sector") @db.VarChar(100)
  industry    String?  @map("industry") @db.VarChar(100)
  description String?  @map("description")
  logo        String?  @map("logo") @db.VarChar(500)
  website     String?  @map("website") @db.VarChar(255)
  marketCap   BigInt?  @map("market_cap")
  currency    String   @default("KRW") @map("currency") @db.VarChar(3)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  type        String   @default("STOCK") @map("type") @db.VarChar(10)

  @@index([name], map: "idx_stock_name")
  @@index([nameKor], map: "idx_stock_name_kor")
  @@index([symbol], map: "idx_stock_symbol")
  @@index([type], map: "idx_stock_type")
  @@index([market], map: "idx_stock_market")
  @@index([exchange], map: "idx_stock_exchange")
  @@map("stocks")
}
